# Copie ce fichier en .env et remplis-le. .env est ignoré par git.

# --- Enable Banking : identité de l'application ---
# ID d'application obtenu à l'enregistrement sur le Control Panel.
EB_APPLICATION_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# Chemin du .pem RSA téléchargé à l'enregistrement (clé privée).
EB_PRIVATE_KEY_PATH=~/.secrets/enablebanking_app.pem
# Passphrase de la clé privée SI tu l'as chiffrée (recommandé). Sinon laisse vide.
EB_PRIVATE_KEY_PASSPHRASE=

# --- Banque cible ---
# Nom EXACT renvoyé par `list-banks` (ex. "BNP Paribas").
EB_ASPSP_NAME=BNP Paribas
EB_ASPSP_COUNTRY=FR
# Durée de consentement demandée en jours (1-180 ; la banque peut réduire).
EB_ACCESS_VALIDITY_DAYS=90

# --- Stockage local chiffré ---
EB_DATA_DIR=~/.bnp-budget-data
# Passphrase maître qui chiffre le stockage local (AES-256-GCM).
# Choisis-la forte et ne la commit jamais.
BUDGET_MASTER_PASSPHRASE=
